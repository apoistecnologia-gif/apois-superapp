{
  "version": 1,
  "decidedAt": "2026-09-21",
  "provider": "safe2pay",
  "mode": "marketplace_split",
  "activation": "fail_closed_until_controlled_production_e2e",
  "legacyProviders": [
    "mercadopago",
    "asaas",
    "pagbank",
    "openpix"
  ],
