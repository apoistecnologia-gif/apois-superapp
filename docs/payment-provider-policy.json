  "unresolvedCommercialDecision": {
    "key": "SAFE2PAY_PIX_FEE_PAYER",
    "allowed": [
      "receiver",
      "platform"
    ],
    "reason": "Safe2Pay separates split allocation from transaction-fee responsibility; production must not guess who pays the Pix fee."
  }
