# APOIS Superapp — integração local/Codemagic
# Não versionar valores reais neste arquivo.

# Corridas — Supabase do passageiro
CORRIDAS_VITE_SUPABASE_URL=
CORRIDAS_VITE_SUPABASE_PUBLISHABLE_KEY=

# Corridas — URL HTTPS pública que hospeda a rota #/acompanhar/:token.
# É necessária para o botão de compartilhar corrida funcionar no APK.
CORRIDAS_PUBLIC_APP_URL=

# Entregas — Supabase produção
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Maps
# Web: restringir para Maps JavaScript API / Places conforme uso do módulo Corridas.
CORRIDAS_WEB_MAPS_API_KEY=
# Android: restringir ao package br.com.apois.app + SHA-1 da assinatura de produção.
CORRIDAS_ANDROID_MAPS_API_KEY=
# Opcional: Map ID vetorial dedicado ao mapa do Entregador. Sem ele o Partner
# usa DEMO_MAP_ID como fallback funcional; para produção visual definitiva, usar
# um Map ID do mesmo projeto Google Cloud da chave web.
ENTREGAS_GOOGLE_MAPS_MAP_ID=

# Firebase unificado do Superapp Cliente Android.
# Base64 do google-services.json cujo client Android contenha br.com.apois.app.
FIREBASE_SUPERAPP_GOOGLE_SERVICES_JSON_BASE64=

# Firebase do APOIS Parceiro Android.
# Deve pertencer ao MESMO projeto Firebase usado pelos backends de Push e conter
# um client Android para br.com.apois.parceiro.
FIREBASE_PARTNER_GOOGLE_SERVICES_JSON_BASE64=
PARTNER_FIREBASE_PROJECT_ID=movvi-4d041

# Project ID do service account FIREBASE_SERVICE_ACCOUNT_B64 usado pela Edge Function
# send-ride-push do backend de Corridas. Só é obrigatório quando o Push de Corridas
# for explicitamente habilitado; deve ser idêntico ao project_id do google-services.json.
CORRIDAS_FIREBASE_PROJECT_ID=

# Corridas mantém o FCM próprio desligado por padrão até a estratégia unificada ser homologada.
APOIS_SUPERAPP_RIDES_PUSH_ENABLED=0

# Validação nativa. Use 1 somente na homologação final quando Maps/Firebase estiverem configurados.
APOIS_STRICT_NATIVE_CONFIG=0

# Android / Google Play
# A partir de 31/08/2026, novos apps/updates precisam target API 36. O hardener fixa API 36.

# Injetados pelo workflow/ambiente de assinatura
APP_PACKAGE=br.com.apois.app
APP_LABEL=APOIS
APP_VERSION_CODE=1
APP_VERSION_NAME=1.0.0
PARTNER_APP_PACKAGE=br.com.apois.parceiro
PARTNER_VERSION_CODE=1
PARTNER_VERSION_NAME=1.0.0
PARTNER_APP_LABEL=APOIS Parceiro
EXPECTED_SIGNING_SHA1=

# Safe2Pay Marketplace — provedor eletrônico oficial do APOIS.
# Estes valores são SEGREDOS DE BACKEND e devem ser cadastrados como secrets
# das Edge Functions/Supabase. Nunca embutir API key em Vite/Android.
SAFE2PAY_API_KEY=
SAFE2PAY_API_KEY_SANDBOX=
SAFE2PAY_SECRET_KEY=
SAFE2PAY_SECRET_KEY_SANDBOX=
# URL HTTPS pública para webhooks transacionais Safe2Pay.
# Ex.: https://<PROJECT_REF>.supabase.co/functions/v1/safe2pay-webhook
SAFE2PAY_CALLBACK_URL=
# Pix Safe2Pay não possui sandbox. Ative somente após validações estáticas, receiver e teste real controlado de baixo valor.
SAFE2PAY_PROVIDER_ENABLED=0
# Política comercial obrigatória antes de produção: receiver | platform.
# Não inventar valor: define quem suporta a tarifa Safe2Pay no split.
SAFE2PAY_PIX_FEE_PAYER=

# Ao implantar safe2pay-webhook, configure por projeto: rides (Corridas) ou orders (Entregas).
SAFE2PAY_WEBHOOK_PRODUCT=
SAFE2PAY_ENVIRONMENT=production

# Escopo do endpoint de onboarding/reconciliação de subcontas: rides ou orders.
SAFE2PAY_ONBOARDING_PRODUCT=
