{
  "modules": {
    "corridas": {
      "source": "sources/apois-corridas-passageiro",
      "workspace": ".work/corridas",
      "install": ["bun", "install", "--frozen-lockfile"],
      "build": ["bun", "run", "build:capacitor"],
      "purpose": "APOIS Corridas - passageiro"
    },
    "entregas": {
      "source": "sources/apois-entregas",
      "workspace": ".work/entregas",
      "install": ["bun", "install", "--frozen-lockfile"],
      "build": ["bun", "run", "build:customer"],
      "env": {
        "APOIS_MOBILE_BUILD": "1",
        "VITE_APOIS_PRODUCT_MODE": "customer"
      },
      "render": {
        "server": ["node", ".output/server/index.mjs"],
        "host": "127.0.0.1",
        "port": 4173,
        "route": "/",
        "output": ".output/public/index.html"
      },
      "purpose": "APOIS Entregas - cliente"
    }
  },
  "rule": "Never patch source submodules. Copy to .work first and patch/build only there."
}
