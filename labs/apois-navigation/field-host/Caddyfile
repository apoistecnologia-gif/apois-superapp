{
    # No access logging; no admin endpoint reachable from the host.
    admin off
    servers {
        timeouts {
            read_header 5s
            read_body 5s
            write 20s
            idle 5s
        }
    }
}
{$APOIS_FIELD_HOST} {
    @route {
        method POST
        path /route
    }
    handle @route {
        request_body {
            max_size 4096
        }
        reverse_proxy 127.0.0.1:8003 {
            transport http {
                dial_timeout 2s
                response_header_timeout 15s
            }
        }
    }
    handle {
        respond 404
    }
}
