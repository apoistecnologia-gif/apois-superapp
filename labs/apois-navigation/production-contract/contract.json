    {
      "name": "rides_accepted_driver_id_fkey",
      "definition": "FOREIGN KEY (accepted_driver_id) REFERENCES drivers(id)"
    },
    {
      "name": "rides_category_check",
      "definition": "CHECK ((category = ANY (ARRAY['carros'::text, 'motos'::text, 'fretes'::text, 'guincho'::text, 'envios'::text])))"
    },
    {
      "name": "rides_driver_id_fkey",
      "definition": "FOREIGN KEY (driver_id) REFERENCES drivers(id)"
    },
    {
      "name": "rides_driver_to_passenger_rating_check",
      "definition": "CHECK (((driver_to_passenger_rating IS NULL) OR ((driver_to_passenger_rating >= 1) AND (driver_to_passenger_rating <= 5))))"
    },
    {
      "name": "rides_estimated_price_check",
      "definition": "CHECK ((estimated_price >= (0)::numeric))"
    },
    {
      "name": "rides_financial_snapshot_arithmetic",
      "definition": "CHECK ((((fare_amount_cents IS NULL) AND (processing_fee_cents IS NULL) AND (passenger_charge_cents IS NULL)) OR ((fare_amount_cents IS NOT NULL) AND (processing_fee_cents IS NOT NULL) AND (passenger_charge_cents IS NOT NULL) AND (passenger_charge_cents = (fare_amount_cents + processing_fee_cents)))))"
    },
    {
      "name": "rides_financial_snapshot_nonnegative",
      "definition": "CHECK ((((fare_amount_cents IS NULL) OR (fare_amount_cents > 0)) AND ((processing_fee_cents IS NULL) OR (processing_fee_cents >= 0)) AND ((passenger_charge_cents IS NULL) OR (passenger_charge_cents > 0))))"
    },
    {
      "name": "rides_passenger_id_fkey",
      "definition": "FOREIGN KEY (passenger_id) REFERENCES users(id)"
    },
    {
      "name": "rides_payment_status_check",
      "definition": "CHECK (((payment_status IS NULL) OR (payment_status = ANY (ARRAY['pending'::text, 'paid'::text, 'expired'::text, 'failed'::text, 'refunded'::text]))))"
    },
    {
      "name": "rides_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "rides_queued_after_ride_id_fkey",
      "definition": "FOREIGN KEY (queued_after_ride_id) REFERENCES rides(id) ON DELETE SET NULL"
    },
    {
      "name": "rides_request_key_key",
      "definition": "UNIQUE (request_key)"
    },
    {
      "name": "rides_security_code_failed_attempts_nonnegative",
      "definition": "CHECK ((security_code_failed_attempts >= 0))"
    },
    {
      "name": "rides_share_token_key",
      "definition": "UNIQUE (share_token)"
    },
    {
      "name": "rides_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['agendada'::text, 'aguardando_pagamento'::text, 'procurar_motorista'::text, 'motorista_a_caminho'::text, 'motorista_chegou'::text, 'em_viagem'::text, 'finalizada'::text, 'cancelada_passageiro'::text, 'cancelada_motorista'::text, 'expired'::text])))"
    }
